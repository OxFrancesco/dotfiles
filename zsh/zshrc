# --- Navigation Shortcut ---
# Use `move home` to return to the home directory from anywhere.
move() {
  case "$1" in
    home)
      if (( $# != 1 )); then
        print -u2 "usage: move home"
        return 2
      fi
      builtin cd -- "$HOME"
      ;;
    ''|-h|--help)
      print "usage: move home"
      ;;
    *)
      print -u2 "move: unknown destination: $1"
      print -u2 "usage: move home"
      return 2
      ;;
  esac
}

# --- OpenClaw Shortcut ---
# Support `openclaw restart` and `openclaw r` as a shortcut for the doctor + fix flow.
openclaw() {
  case "$1" in
    restart|r)
      if [ "$#" -gt 1 ]; then
        echo "openclaw: '$1' does not accept extra arguments" >&2
        return 2
      fi
      command openclaw doctor && command openclaw doctor --fix
      ;;
    *)
      command openclaw "$@"
      ;;
  esac
}

# --- tmux Shortcut ---
# Support `tmux create [session-name]` as a shortcut for `tmux new-session`,
# and `tmux move <session-name>` to jump to an existing session.
tmux() {
  case "$1" in
    create)
      shift
      if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        echo "usage: tmux create [session-name] [tmux new-session flags]" >&2
        return 0
      fi

      if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
        local session_name="$1"
        shift
        command tmux new-session -s "$session_name" "$@"
      else
        command tmux new-session "$@"
      fi
      ;;
    move)
      shift
      if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ $# -eq 0 ]; then
        echo "usage: tmux move <session-name>" >&2
        return $([ $# -eq 0 ] && echo 2 || echo 0)
      fi

      local session_name="$1"
      shift

      if [ -n "$TMUX" ]; then
        command tmux switch-client -t "$session_name" "$@"
      else
        command tmux attach-session -t "$session_name" "$@"
      fi
      ;;
    *)
      command tmux "$@"
      ;;
  esac
}

