# --- Francesco Prompt ---
# Compact two-line prompt with local Git state and cached GitHub PR context.
autoload -U colors && colors
autoload -Uz add-zsh-hook
setopt PROMPT_SUBST

typeset -g FRANCESCO_PROMPT_RESET=$'%{\e[0m%}'
typeset -g FRANCESCO_PROMPT_DIM=$'%{\e[2m%}'
typeset -g FRANCESCO_PROMPT_RED=$'%{\e[38;2;209;0;28m%}'
typeset -g FRANCESCO_PROMPT_BLUE=$'%{\e[38;2;90;170;255m%}'
typeset -g FRANCESCO_PROMPT_GREEN=$'%{\e[38;2;80;200;120m%}'
typeset -g FRANCESCO_PROMPT_YELLOW=$'%{\e[38;2;245;190;70m%}'
typeset -g FRANCESCO_PROMPT_MAGENTA=$'%{\e[38;2;205;120;255m%}'
typeset -g FRANCESCO_VCS_SEGMENT=''
typeset -g FRANCESCO_EXIT_SEGMENT=''
typeset -g FRANCESCO_GH_CACHE_KEY=''
typeset -g FRANCESCO_GH_CACHE_INFO=''
typeset -gi FRANCESCO_GH_CACHE_UPDATED=-999999
typeset -gi FRANCESCO_GH_CACHE_SECONDS=60

francesco_prompt_update_github() {
  local repo_root="$1"
  local branch="$2"
  local cache_key="${repo_root}:${branch}"

  if [[ "$cache_key" == "$FRANCESCO_GH_CACHE_KEY" ]] &&
     (( SECONDS - FRANCESCO_GH_CACHE_UPDATED < FRANCESCO_GH_CACHE_SECONDS )); then
    return
  fi

  FRANCESCO_GH_CACHE_KEY="$cache_key"
  FRANCESCO_GH_CACHE_UPDATED=$SECONDS
  FRANCESCO_GH_CACHE_INFO=''

  (( $+commands[gh] && $+commands[jq] )) || return

  local pr_json parsed
  pr_json=$(command gh pr list --state open --limit 100 \
    --json number,headRefName,isDraft 2>/dev/null) || return
  parsed=$(print -r -- "$pr_json" | command jq -r --arg branch "$branch" '
    (map(select(.headRefName == $branch)) | first) as $current
    | [length, ($current.number // 0), ($current.isDraft // false)]
    | join("|")
  ' 2>/dev/null) || return

  local -a fields
  fields=(${(s:|:)parsed})
  local open_count="${fields[1]:-0}"
  local current_pr="${fields[2]:-0}"
  local is_draft="${fields[3]:-false}"
  local info=''

  if (( current_pr > 0 )); then
    info+="  ${FRANCESCO_PROMPT_MAGENTA}PR #${current_pr}${FRANCESCO_PROMPT_RESET}"
    [[ "$is_draft" == true ]] && info+=" ${FRANCESCO_PROMPT_DIM}(draft)${FRANCESCO_PROMPT_RESET}"
  fi
  info+="  ${FRANCESCO_PROMPT_DIM}·${FRANCESCO_PROMPT_RESET} ${FRANCESCO_PROMPT_MAGENTA}PRs:${open_count}${FRANCESCO_PROMPT_RESET}"
  FRANCESCO_GH_CACHE_INFO="$info"
}

francesco_prompt_update() {
  local exit_code=$?
  FRANCESCO_EXIT_SEGMENT=''
  FRANCESCO_VCS_SEGMENT=''

  if (( exit_code != 0 )); then
    FRANCESCO_EXIT_SEGMENT="${FRANCESCO_PROMPT_RED}✘ ${exit_code}${FRANCESCO_PROMPT_RESET}  "
  fi

  local git_state
  git_state=$(command git status --porcelain=v2 --branch 2>/dev/null) || return 0

  local branch='' oid=''
  local -i staged=0 modified=0 untracked=0 conflicts=0 ahead=0 behind=0
  local line x y ab
  local -a counts

  for line in ${(f)git_state}; do
    case "$line" in
      '# branch.oid '*)
        oid="${line#\# branch.oid }"
        ;;
      '# branch.head '*)
        branch="${line#\# branch.head }"
        ;;
      '# branch.ab '*)
        ab="${line#\# branch.ab }"
        counts=(${=ab})
        ahead="${counts[1]#+}"
        behind="${counts[2]#-}"
        ;;
      '1 '*|'2 '*)
        x="${line[3]}"
        y="${line[4]}"
        [[ "$x" != '.' ]] && (( ++staged ))
        [[ "$y" != '.' ]] && (( ++modified ))
        ;;
      'u '*)
        (( ++conflicts ))
        ;;
      '?'*)
        (( ++untracked ))
        ;;
    esac
  done

  [[ "$branch" == '(detached)' ]] && branch="${oid[1,7]}"
  [[ -z "$branch" ]] && branch='unknown'
  branch="${branch//\%/%%}"

  local segment="${FRANCESCO_PROMPT_DIM}git${FRANCESCO_PROMPT_RESET} ${FRANCESCO_PROMPT_YELLOW}${branch}${FRANCESCO_PROMPT_RESET}"
  if (( staged == 0 && modified == 0 && untracked == 0 && conflicts == 0 )); then
    segment+=" ${FRANCESCO_PROMPT_GREEN}✓${FRANCESCO_PROMPT_RESET}"
  else
    (( staged > 0 )) && segment+=" ${FRANCESCO_PROMPT_GREEN}+${staged}${FRANCESCO_PROMPT_RESET}"
    (( modified > 0 )) && segment+=" ${FRANCESCO_PROMPT_YELLOW}~${modified}${FRANCESCO_PROMPT_RESET}"
    (( untracked > 0 )) && segment+=" ${FRANCESCO_PROMPT_BLUE}?${untracked}${FRANCESCO_PROMPT_RESET}"
    (( conflicts > 0 )) && segment+=" ${FRANCESCO_PROMPT_RED}!${conflicts}${FRANCESCO_PROMPT_RESET}"
  fi
  (( ahead > 0 )) && segment+=" ${FRANCESCO_PROMPT_GREEN}↑${ahead}${FRANCESCO_PROMPT_RESET}"
  (( behind > 0 )) && segment+=" ${FRANCESCO_PROMPT_RED}↓${behind}${FRANCESCO_PROMPT_RESET}"

  local repo_root
  repo_root=$(command git rev-parse --show-toplevel 2>/dev/null)
  francesco_prompt_update_github "$repo_root" "$branch"
  FRANCESCO_VCS_SEGMENT="${segment}${FRANCESCO_GH_CACHE_INFO}  "
  return 0
}

# Run `prompt-refresh` after creating or closing a PR to bypass the 60-second cache.
prompt-refresh() {
  FRANCESCO_GH_CACHE_UPDATED=-999999
  FRANCESCO_GH_CACHE_KEY=''
}

