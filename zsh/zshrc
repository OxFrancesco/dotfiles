# --- Francesco Oddo Terminal Banner ---
# Show the compact horizontal wordmark once per interactive shell.
francesco_banner() {
  [[ -o interactive ]] || return
  [[ "$FRANCESCO_BANNER_SHELL_PID" == "$$" ]] && return
  typeset -g FRANCESCO_BANNER_SHELL_PID=$$

  local reset=$'\e[0m'
  local red=$'\e[38;2;209;0;28m'

  printf '\n%b' "$red"
  cat <<'EOF'
█▀▀ █▀█ █▀█ █▄ █ █▀▀ █▀▀ █▀▀ █▀▀ █▀█   █▀█ █▀▄ █▀▄ █▀█
█▀  █▀▄ █▀█ █ ▀█ █   █▀  ▀▀█ █   █ █   █ █ █ █ █ █ █ █
▀   ▀ ▀ ▀ ▀ ▀  ▀ ▀▀▀ ▀▀▀ ▀▀▀ ▀▀▀ ▀▀▀   ▀▀▀ ▀▀  ▀▀  ▀▀▀
EOF
  printf '%b\n' "$reset"
}
